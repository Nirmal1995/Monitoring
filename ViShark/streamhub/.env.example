# =============================================================================
# StreamHub local development environment
# =============================================================================
# Do not edit this file to hold real values. Create your own .env with:
#
#     pnpm env:init
#
# which copies this template and replaces every GENERATE placeholder with a
# random value. .env is git-ignored. These are DEVELOPMENT-ONLY credentials
# for services bound to 127.0.0.1. Production uses AWS Secrets Manager.
#
# Generated secrets are hex, so they never need URL-encoding inside the
# connection strings below.
# =============================================================================

# ---- API ----------------------------------------------------------------------
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# Prometheus metrics are served on a separate port that is never exposed publicly.
API_METRICS_HOST=127.0.0.1
API_METRICS_PORT=4001
# Swagger UI at /api/docs. Defaults to true outside production.
API_DOCS_ENABLED=true
API_BODY_LIMIT=100kb
# Reverse proxies in front of the API: 0 locally. Needed to trust X-Forwarded-For.
API_TRUST_PROXY_HOPS=0
API_SHUTDOWN_TIMEOUT_MS=10000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs for local development. Must be false in production.
LOG_PRETTY=true

# ---- Authentication and sessions ------------------------------------------
# Signs the session cookie. Long random value; rotating it signs everyone out.
SESSION_SECRET=__GENERATE_SESSION_SECRET__
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# Browser origin of the web app; state-changing requests must come from here.
WEB_ORIGIN=http://localhost:5273
# Also trust Swagger UI on the API port (development only).
CSRF_EXTRA_TRUSTED_ORIGINS=http://127.0.0.1:4000,http://localhost:4000
# Argon2id cost (OWASP minimum shown). Raising these upgrades hashes at next login.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Login/register requests per client IP per window, and failed logins per email per window.
AUTH_IP_LIMIT=20
AUTH_IP_WINDOW_SECONDS=900
AUTH_ACCOUNT_FAILURE_LIMIT=10
AUTH_ACCOUNT_FAILURE_WINDOW_SECONDS=900
# Emails per address per hour from "resend verification" and "forgot password".
AUTH_EMAIL_LIMIT_PER_HOUR=3
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# ---- Host ports (all services publish on 127.0.0.1 only) --------------------
MONGO_PORT=27017
REDIS_PORT=6379
STORAGE_API_PORT=9000
STORAGE_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---- MongoDB ----------------------------------------------------------------
# Root user: used only for administration and the first-start init script.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=__GENERATE_MONGO_ROOT_PASSWORD__
# Application user: readWrite on MONGO_APP_DATABASE only (least privilege).
MONGO_APP_DATABASE=streamhub
MONGO_APP_USERNAME=streamhub_app
MONGO_APP_PASSWORD=__GENERATE_MONGO_APP_PASSWORD__
# directConnection=true: talk to the single replica set member directly instead
# of using the host name advertised inside Docker ("mongo:27017"), which does
# not resolve from WSL.
MONGO_URL=mongodb://streamhub_app:__GENERATE_MONGO_APP_PASSWORD__@127.0.0.1:27017/streamhub?authSource=streamhub&directConnection=true

# ---- Redis (BullMQ queues, rate limit counters) -----------------------------
REDIS_PASSWORD=__GENERATE_REDIS_PASSWORD__
REDIS_URL=redis://default:__GENERATE_REDIS_PASSWORD__@127.0.0.1:6379/0

# ---- Object storage (Silo, S3-compatible MinIO fork) ------------------------
# Root credentials: admin only (console, bucket init). The app never uses them.
STORAGE_ROOT_USER=storage-admin
STORAGE_ROOT_PASSWORD=__GENERATE_STORAGE_ROOT_PASSWORD__
# Application credentials: limited to the two buckets below.
S3_ACCESS_KEY_ID=streamhub-app
S3_SECRET_ACCESS_KEY=__GENERATE_S3_SECRET_ACCESS_KEY__
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=eu-west-1
# Path-style URLs (http://host/bucket/key) are required for MinIO-compatible
# servers on localhost. Real S3 uses virtual-hosted style (false).
S3_FORCE_PATH_STYLE=true
S3_BUCKET_UPLOADS=streamhub-uploads
S3_BUCKET_MEDIA=streamhub-media
# Browser origin allowed to upload/stream directly from storage (the web app).
STORAGE_CORS_ALLOW_ORIGIN=http://localhost:5273

# ---- Email (Mailpit captures everything; nothing is really sent) -----------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="StreamHub <no-reply@streamhub.local>"
MAILPIT_API_URL=http://127.0.0.1:8025
