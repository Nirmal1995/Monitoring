{
  "name": "@streamhub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CHOKIDAR_USEPOLLING=1 CHOKIDAR_INTERVAL=1000 tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start:local": "tsx --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "admin:create": "tsx --env-file-if-exists=../../.env src/cli/create-admin.ts"
  },
  "dependencies": {
    "@streamhub/contracts": "workspace:*",
    "@streamhub/shared": "workspace:*",
    "argon2": "0.45.2",
    "connect-mongo": "6.0.0",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "mongodb": "7.8.0",
    "mongoose": "9.12.0",
    "nodemailer": "10.4.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1"
  }
}
